{
  "manifest_version": 3,
  "name": "양파군 대피소",
  "version": "1.0.1",
  "description": "dvd prime 전용 양파군 이모지 확장 프로그램",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["clipboardWrite"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "양파군 대피소",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
